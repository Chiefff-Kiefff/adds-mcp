FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Kerberos client libraries for WinRM auth (negotiate/kerberos).
RUN apt-get update && apt-get install -y --no-install-recommends \
        krb5-user libkrb5-dev libssl-dev gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --upgrade pip && pip install ".[adcs]"

EXPOSE 8081

CMD ["adcs-mcp"]

# Active Directory connection settings for the read-only MCP server.
# Copy to .env and fill in real values.

# Comma-separated list of domain controllers (LDAPS on 636 by default).
ADDS_SERVERS=dc01.corp.example.com,dc02.corp.example.com

# LDAPS port. Use 636 for LDAPS or 3269 for Global Catalog over TLS.
ADDS_PORT=636

# Service account for read-only binds. Use a dedicated, least-privilege account.
ADDS_BIND_DN=CN=svc-adds-readonly,OU=Service Accounts,DC=corp,DC=example,DC=com
ADDS_BIND_PASSWORD=change-me

# Default search base for user/group/OU queries.
ADDS_BASE_DN=DC=corp,DC=example,DC=com

# Optional: NetBIOS/DNS domain name (used for display only).
ADDS_DOMAIN=corp.example.com

# TLS behavior. Set to "false" only for lab environments.
ADDS_TLS_VALIDATE=true
# Optional path to a CA bundle for validating the DC certificate.
ADDS_CA_CERT_FILE=

# HTTP transport bind address and port.
ADDS_HTTP_HOST=0.0.0.0
ADDS_HTTP_PORT=8080

# Safety limits.
ADDS_MAX_PAGE_SIZE=500
ADDS_DEFAULT_PAGE_SIZE=50
ADDS_QUERY_TIMEOUT_SECONDS=30

# --- adcs-mcp additions -----------------------------------------------------
# Comma-separated list of online issuing CA hostnames (Windows, WinRM-reachable).
ADCS_CA_HOSTS=issuing-ca01.corp.example.com,issuing-ca02.corp.example.com

# WinRM service account. In production, prefer Kerberos with a keytab
# over storing a password here.
ADCS_WINRM_USER=CORP\svc-adcs-readonly
ADCS_WINRM_PASSWORD=change-me
ADCS_WINRM_AUTH=negotiate     # negotiate|kerberos|ntlm|basic|credssp
ADCS_WINRM_PORT=5986
ADCS_WINRM_USE_HTTPS=true
ADCS_WINRM_CERT_VALIDATION=true

# CRL/AIA web server leg. Optional comma-separated list of the HTTP(S) CDP/AIA
# distribution points baked into issued certs. check_crl_aia_endpoints probes
# these for reachability and CRL freshness when called with no arguments.
ADCS_CRL_AIA_URLS=http://pki.corp.example.com/crl/IssuingCA01.crl,http://pki.corp.example.com/crl/IssuingCA02.crl,http://pki.corp.example.com/aia/IssuingCA01.crt
# Seconds before an HTTP(S) fetch times out.
ADCS_WEB_TIMEOUT=20
# Validate TLS on https:// endpoints. Set to "false" only for lab work.
ADCS_WEB_TLS_VALIDATE=true
# Optional CA bundle for validating the web server certificate.
ADCS_WEB_CA_CERT_FILE=

# HTTP transport for adcs-mcp (kept separate from adds-mcp).
ADCS_HTTP_HOST=0.0.0.0
ADCS_HTTP_PORT=8081

# --- addns-mcp additions ----------------------------------------------------
# HTTP transport for addns-mcp (reuses the ADDS_* LDAPS bind).
ADDNS_HTTP_HOST=0.0.0.0
ADDNS_HTTP_PORT=8082

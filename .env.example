# Active Directory connection settings for the read-only MCP server.
# Copy to .env and fill in real values.

# Comma-separated list of domain controllers (LDAPS on 636 by default).
ADDS_SERVERS=dc01.corp.example.com,dc02.corp.example.com

# LDAPS port. Use 636 for LDAPS or 3269 for Global Catalog over TLS.
ADDS_PORT=636

# Service account for read-only binds. Use a dedicated, least-privilege account.
ADDS_BIND_DN=CN=svc-adds-readonly,OU=Service Accounts,DC=corp,DC=example,DC=com
ADDS_BIND_PASSWORD=change-me

# Default search base for user/group/OU queries.
ADDS_BASE_DN=DC=corp,DC=example,DC=com

# Optional: NetBIOS/DNS domain name (used for display only).
ADDS_DOMAIN=corp.example.com

# TLS behavior. Set to "false" only for lab environments.
ADDS_TLS_VALIDATE=true
# Optional path to a CA bundle for validating the DC certificate.
ADDS_CA_CERT_FILE=

# HTTP transport bind address and port.
ADDS_HTTP_HOST=0.0.0.0
ADDS_HTTP_PORT=8080

# Safety limits.
ADDS_MAX_PAGE_SIZE=500
ADDS_DEFAULT_PAGE_SIZE=50
ADDS_QUERY_TIMEOUT_SECONDS=30
